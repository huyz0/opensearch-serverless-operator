+    public void testFindsPhysicalHeadsWithoutLocalStateAndSeparatesOtherIncarnations() throws Exception {
+        try (var storage = new FsBlobStore(8192, createTempDir(), false)) {
+            final BlobPath base = BlobPath.cleanPath();
+            final var plane = new MetadataPlane(storage, base, () -> 1_000L, 30_000L);
+            final var container = ConditionalBlobContainer.of(storage.blobContainer(RegisterMap.shards(base)));
+            put(container, new ShardHead("cold", 2, 7L, "node", "process", 2_000L, "uuid-cold"));
+            put(container, new ShardHead(ShardHeadStore.bucketHeadIndex("bucket-a"), 0, 8L, "node", "process", 2_000L));
+            assertTrue(
+                container.createRegisterIfAbsent(
+                    RegisterMap.shardHeadBlob("legacy", 0),
+                    new BytesArray("{\"index\":\"legacy\",\"shard\":0,\"term\":6,\"owner_node_id\":\"node\"}")
+                ).applied()
+            );
+            put(container, new ShardHead("new-process", 1, 9L, "node", "replacement", 2_000L, "uuid-replacement"));
+            put(container, new ShardHead("other-node", 0, 4L, "other", "process", 2_000L, "uuid-other"));
+            put(container, new ShardHead("released", 0, 3L, null, null, 0L, "uuid-released"));
+
+            String after = null;
+            final var found = new ArrayList<ShardHeadStore.OwnedHead>();
+            int pages = 0;
+            int emptyPages = 0;
+            do {
+                final var page = plane.heads().scanOwnedHeads("node", "process", after, 1);
+                assertTrue("cursor did not advance", ++pages <= 6);
+                found.addAll(page.heads());
+                if (page.heads().isEmpty()) {
+                    emptyPages++;
+                }
+                after = page.nextAfter();
+            } while (after != null);
+            assertEquals(6, pages);
+            assertEquals(3, emptyPages);
+            assertEquals(
+                Set.of("cold", "legacy", ShardHeadStore.bucketHeadIndex("bucket-a")),
+                found.stream().map(head -> head.head().indexName()).collect(Collectors.toSet())
+            );
+            assertEquals(3, found.size());
+            final var bucket = found.stream().filter(head -> head.bucketId() != null).findFirst().orElseThrow();
+            assertEquals("bucket-a", bucket.bucketId());
+            assertEquals(8L, bucket.head().term());
+            final var legacy = found.stream().filter(head -> head.head().indexName().equals("legacy")).findFirst().orElseThrow();
+            assertNull(legacy.head().ownerEphemeralId());
+        }
+    }
