+    public void testWriterSuccessorRequiresANewerForegroundWrite() throws Exception {
+        final AtomicLong clock = new AtomicLong(1_000L);
+        final MetadataPlane plane = plane(clock);
+        final String uuid = "successor-test-uuid";
+        plane.createIndex(new IndexDescriptor("successor", uuid, 1, "{\"properties\":{\"message\":{\"type\":\"keyword\"}}}", null));
+        final var previous = plane.heads().acquire("successor", 0, "old-writer", "old-process", uuid).head();
+        assertEquals(1L, previous.term());
+        plane.heads().release("successor", 0, "old-writer", previous.term());
+        final Settings settings = Settings.builder()
+            .put(nodeSettings("successor-observer"))
+            .put(NodeSettings.WRITER_HANDOFF_READER.getKey(), "receipt-reader")
+            .put("http.type", org.opensearch.transport.Netty4ModulePlugin.NETTY_SECURE_HTTP_TRANSPORT_NAME)
+            .build();
+        try (
+            ServerlessNode node = new ServerlessNode(settings, List.of(authPlugin(settings), new ServerlessTlsTests.TlsPlugin()));
+            HttpClient client = HttpClient.newBuilder().sslContext(ServerlessTlsTests.TlsPlugin.httpClientContext()).build()
+        ) {
+            node.startup().start();
+            node.setMetadataPlane(plane);
+            ready(node, plane, clock);
+            final String base = "https://127.0.0.1:" + node.boundHttpAddress().publishAddress().getPort();
+            final String admin = basic(ADMIN, ADMIN_PASSWORD);
+            final String reader = basic("receipt-reader", "reader-password");
+            final Response created = sendAt(
+                client,
+                "PUT",
+                base + "/_serverless/security/users/receipt-reader",
+                admin,
+                "{\"password\":\"reader-password\"}"
+            );
+            assertEquals(created.body(), 200, created.status());
+            final var local = node.localNode();
+            final String prefix = base + "/_serverless/writer_successor/" + local.getId() + "/";
+            final String lookup = "?index=successor&index_uuid=" + uuid + "&shard=0&previous_term=";
+            final String path = prefix + local.getEphemeralId() + lookup;
+            assertEquals(401, sendAt(client, "GET", path + "1", null, null).status());
+            assertEquals(403, sendAt(client, "GET", path + "1", admin, null).status());
+            assertEquals(409, sendAt(client, "GET", prefix + "wrong-process" + lookup + "1", reader, null).status());
+            assertTrue(node.activation().activateWriter(plane, "successor", 0).isPresent());
+            assertEquals(404, sendAt(client, "GET", path + "1", reader, null).status());
+            final Response write = sendAt(
+                client,
+                "PUT",
+                base + "/successor/_doc/after?refresh=true",
+                admin,
+                "{\"message\":\"after takeover\"}"
+            );
+            assertEquals(write.body(), 201, write.status());
+            final Response observation = sendAt(client, "GET", path + "1", reader, null);
+            assertEquals(observation.body(), 200, observation.status());
+            assertTrue(observation.body(), observation.body().contains("\"term\":2"));
+            assertEquals(404, sendAt(client, "GET", path + "2", reader, null).status());
+            assertEquals(404, sendAt(client, "GET", path.replace(uuid, "another-uuid") + "1", reader, null).status());
+        }
+    }
