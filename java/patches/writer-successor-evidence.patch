+package org.opensearch.serverless.rest;
+
+import org.opensearch.common.util.concurrent.AbstractRunnable;
+import org.opensearch.core.index.shard.ShardId;
+import org.opensearch.core.rest.RestStatus;
+import org.opensearch.http.netty4.ssl.SecureNetty4HttpServerTransport;
+import org.opensearch.identity.NamedPrincipal;
+import org.opensearch.index.shard.IndexShard;
+import org.opensearch.index.shard.IndexShardState;
+import org.opensearch.rest.BaseRestHandler;
+import org.opensearch.rest.BytesRestResponse;
+import org.opensearch.rest.RestChannel;
+import org.opensearch.rest.RestRequest;
+import org.opensearch.serverless.metadata.MetadataPlane;
+import org.opensearch.serverless.node.NodeContext;
+import org.opensearch.serverless.reconcile.WriterHandoffReceiptStore;
+import org.opensearch.serverless.restcore.RestReplies;
+import org.opensearch.transport.client.node.NodeClient;
+
+import java.io.IOException;
+import java.security.Principal;
+import java.util.List;
+import java.util.function.Supplier;
+
+/** Observes a real foreground write after writer takeover, without opening a shard or writing a probe document. */
+public final class WriterSuccessorHandler extends BaseRestHandler {
+    private final NodeContext node;
+    private final Supplier<Principal> principal;
+    private final String reader;
+
+    public WriterSuccessorHandler(NodeContext node, Supplier<Principal> principal, String reader) {
+        this.node = node;
+        this.principal = principal;
+        this.reader = reader;
+    }
+
+    @Override
+    public String getName() {
+        return "serverless_writer_successor";
+    }
+
+    @Override
+    public List<Route> routes() {
+        return List.of(new Route(RestRequest.Method.GET, "/_serverless/writer_successor/{node_id}/{ephemeral_id}"));
+    }
+
+    @Override
+    protected RestChannelConsumer prepareRequest(RestRequest request, NodeClient client) {
+        final String nodeId = request.param("node_id");
+        final String ephemeralId = request.param("ephemeral_id");
+        final String index = request.param("index");
+        final String uuid = request.param("index_uuid");
+        final int shard = request.paramAsInt("shard", -1);
+        final long previousTerm = request.paramAsLong("previous_term", -1L);
+        final Principal caller = principal.get();
+        if (caller == null
+            || NamedPrincipal.UNAUTHENTICATED.getName().equals(caller.getName())
+            || reader.equals(caller.getName()) == false
+            || node.httpServerTransport instanceof SecureNetty4HttpServerTransport == false) {
+            return channel -> error(
+                channel,
+                RestStatus.FORBIDDEN,
+                "not_permitted",
+                "writer successor evidence requires the HTTPS handoff reader"
+            );
+        }
+        if (WriterHandoffReceiptStore.isProcessId(nodeId) == false
+            || WriterHandoffReceiptStore.isProcessId(ephemeralId) == false
+            || WriterHandoffReceiptStore.isProcessId(uuid) == false
+            || index == null
+            || index.isEmpty()
+            || index.length() > 255
+            || index.startsWith("#bucket#")
+            || shard < 0
+            || previousTerm < 1L) {
+            return channel -> error(
+                channel,
+                RestStatus.BAD_REQUEST,
+                "invalid_writer_successor_target",
+                "a process and exact independent shard are required"
+            );
+        }
+        final var metadata = node.metadataPlane();
+        if (node.isStarted() == false || metadata == null) {
+            return WriterSuccessorHandler::unavailable;
+        }
+        final var local = node.localNode();
+        if (nodeId.equals(local.getId()) == false || ephemeralId.equals(local.getEphemeralId()) == false) {
+            return channel -> error(channel, RestStatus.CONFLICT, "observer_process_changed", "target does not identify this Java process");
+        }
+        final ShardId shardId = new ShardId(index, uuid, shard);
+        return channel -> node.threadPool().generic().execute(new AbstractRunnable() {
+            @Override
+            protected void doRun() throws IOException {
+                observe(channel, metadata, shardId, previousTerm, nodeId, ephemeralId);
+            }
+
+            @Override
+            public void onFailure(Exception failure) {
+                try {
+                    unavailable(channel);
+                } catch (IOException responseFailure) {
+                    RestReplies.logResponseFailure(logger, getName(), responseFailure);
+                }
+            }
+        });
+    }
+
+    private void observe(RestChannel channel, MetadataPlane metadata, ShardId shardId, long previousTerm, String nodeId, String ephemeralId)
+        throws IOException {
+        final IndexShard writer = node.reconciler().writerShard(shardId);
+        final long term = writer == null ? -1L : writer.getOperationPrimaryTerm();
+        if (term <= previousTerm || writerCurrent(metadata, shardId, writer, term) == false) {
+            pending(channel);
+            return;
+        }
+        final var head = metadata.heads().read(shardId.getIndexName(), shardId.id());
+        if (head.isEmpty()
+            || head.get().term() != term
+            || nodeId.equals(head.get().ownerNodeId()) == false
+            || ephemeralId.equals(head.get().ownerEphemeralId()) == false
+            || shardId.getIndex().getUUID().equals(head.get().indexUuid()) == false
+            || writerCurrent(metadata, shardId, writer, term) == false) {
+            pending(channel);
+            return;
+        }
+        try (var content = channel.newBuilder()) {
+            content.startObject();
+            content.field("version", 1);
+            content.field("node_id", nodeId);
+            content.field("ephemeral_id", ephemeralId);
+            content.field("index", shardId.getIndexName());
+            content.field("index_uuid", shardId.getIndex().getUUID());
+            content.field("shard", shardId.id());
+            content.field("term", term);
+            content.endObject();
+            send(channel, new BytesRestResponse(RestStatus.OK, content));
+        }
+    }
+
+    private boolean writerCurrent(MetadataPlane metadata, ShardId shardId, IndexShard writer, long term) {
+        return node.activation().isWriterTrafficWithdrawn() == false
+            && node.activation().isWriterAdmissionClosed() == false
+            && node.leases().ownershipUnverified() == false
+            && metadata.membership().selfLeaseValidAt(metadata.clock().getAsLong())
+            && node.reconciler().writerShard(shardId) == writer
+            && writer.state() == IndexShardState.STARTED
+            && writer.getOperationPrimaryTerm() == term
+            && node.fences().isWriteFenced(shardId) == false
+            && node.reconciler().hasAcknowledgedWriterWrite(shardId, term);
+    }
+
+    private static void pending(RestChannel channel) throws IOException {
+        error(channel, RestStatus.NOT_FOUND, "writer_successor_pending", "no newer active writer with a foreground write on this process");
+    }
+
+    private static void unavailable(RestChannel channel) throws IOException {
+        error(channel, RestStatus.SERVICE_UNAVAILABLE, "writer_successor_unavailable", "writer successor evidence could not be read");
+    }
+
+    private static void error(RestChannel channel, RestStatus status, String type, String reason) throws IOException {
+        send(channel, RestReplies.error(channel, status, type, reason));
+    }
+
+    private static void send(RestChannel channel, BytesRestResponse response) throws IOException {
+        response.addHeader("Cache-Control", "no-store");
+        channel.sendResponse(response);
+    }
+}
