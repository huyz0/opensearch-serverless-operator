diff --git a/serverless/shell/src/main/java/org/opensearch/serverless/node/NodeLogStart.java b/serverless/shell/src/main/java/org/opensearch/serverless/node/NodeLogStart.java
index da42c8f..3164e3c 100644
--- a/serverless/shell/src/main/java/org/opensearch/serverless/node/NodeLogStart.java
+++ b/serverless/shell/src/main/java/org/opensearch/serverless/node/NodeLogStart.java
@@ -31,6 +31,15 @@ public final class NodeLogStart {
         this.node = node;
     }
 
+    static String advertiseHost(org.opensearch.common.settings.Settings settings) {
+        final String host = NodeSettings.TRANSPORT_ADVERTISE_HOST.get(settings);
+        if (host.isEmpty()) return host;
+        if (host.length() > 253 || host.matches("(?i)[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*") == false) {
+            throw new IllegalArgumentException("serverless.transport.advertise_host must be a DNS hostname");
+        }
+        return host;
+    }
+
