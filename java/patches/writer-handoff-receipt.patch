+import org.opensearch.serverless.reconcile.WriterHandoffReceiptStore;
+import org.opensearch.serverless.reconcile.WriterHandoffReport;
+import org.opensearch.serverless.reconcile.WriterHandoffReport.Outcome;
+import org.opensearch.serverless.reconcile.WriterHandoffReport.ShardResult;
+import org.opensearch.test.OpenSearchTestCase;
+
+import java.io.IOException;
+import java.util.List;
+
+public class WriterHandoffReceiptStoreTests extends OpenSearchTestCase {
+    public void testLostCreateResponseIsVerifiedAndRetryCannotReplaceReceipt() throws Exception {
+        try (
+            var store = new CrashPointBlobStore(new FsBlobStore(8192, createTempDir(), false)).on(
+                step -> step.kind() == CrashPointBlobStore.Kind.CREATE_REGISTER,
+                CrashPointBlobStore.Fault.AMBIGUOUS,
+                1
+            )
+        ) {
+            final var receipts = new WriterHandoffReceiptStore(store, BlobPath.cleanPath());
+            final var first = new ShardResult(new ShardId("logs", "uuid-logs", 0), 3L, false, Outcome.RELEASED_WITH_WAL, false);
+            final var second = new ShardResult(new ShardId("logs", "uuid-logs", 1), 5L, true, Outcome.UNCONFIRMED, false);
+            final var expected = new WriterHandoffReport("node", "old-process", List.of(first, second));
+            receipts.persist(new WriterHandoffReport("node", "old-process", List.of(second, first)));
+            assertEquals(expected, receipts.read("node", "old-process").orElseThrow());
+            receipts.persist(expected);
+            expectThrows(IOException.class, () -> receipts.persist(new WriterHandoffReport("node", "old-process", List.of())));
+            assertEquals(expected, receipts.read("node", "old-process").orElseThrow());
+            assertTrue(receipts.read("node", "new-process").isEmpty());
+        }
+    }
+
+    public void testUnknownFormatSuppliesNoReceipt() throws Exception {
+        try (var store = new FsBlobStore(8192, createTempDir(), false)) {
+            final BlobPath base = BlobPath.cleanPath();
+            final var container = ConditionalBlobContainer.of(store.blobContainer(base.add("writer-handoffs")));
+            assertTrue(container.createRegisterIfAbsent("node.process", new BytesArray(new byte[] { 2 })).applied());
+            final var receipts = new WriterHandoffReceiptStore(store, base);
+            expectThrows(IOException.class, () -> receipts.read("node", "process"));
+        }
+    }
+
+    public void testConfirmedReleaseRequiresAKnownTerm() throws Exception {
+        try (var store = new FsBlobStore(8192, createTempDir(), false)) {
+            final var receipts = new WriterHandoffReceiptStore(store, BlobPath.cleanPath());
+            final var invalid = new ShardResult(new ShardId("logs", "uuid-logs", 0), -1L, false, Outcome.RELEASED, false);
+            expectThrows(IOException.class, () -> receipts.persist(new WriterHandoffReport("node", "process", List.of(invalid))));
+            assertTrue(receipts.read("node", "process").isEmpty());
+        }
+    }
+}
