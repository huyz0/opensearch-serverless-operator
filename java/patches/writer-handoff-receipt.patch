+import org.opensearch.core.index.shard.ShardId;
+import org.opensearch.serverless.reconcile.WriterHandoffReport.Outcome;
+import org.opensearch.serverless.reconcile.WriterHandoffReport.ShardResult;
+
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.Optional;
+import java.util.regex.Pattern;
+
+/** Stores one immutable shutdown receipt per Java process in the instance's object store. */
+@InternalApi
+public final class WriterHandoffReceiptStore {
+    private static final int FORMAT = 1;
+    private static final int MAX_SHARDS = 16_384;
+    private static final int MAX_BYTES = 4 * 1024 * 1024;
+    private static final Pattern PROCESS_ID = Pattern.compile("[A-Za-z0-9_-]{1,128}");
+    private final ConditionalBlobContainer receipts;
+
+    public WriterHandoffReceiptStore(BlobStore store, BlobPath base) {
+        receipts = ConditionalBlobContainer.of(store.blobContainer(base.add("writer-handoffs")));
+    }
+
+    /** Publishes the report once. A retry of the same report succeeds without replacing it. */
+    public void persist(WriterHandoffReport report) throws IOException {
+        final String key = key(report.nodeId(), report.ephemeralId());
+        final BytesReference encoded = encode(report);
+        try {
+            if (receipts.createRegisterIfAbsent(key, encoded).applied()) {
+                return;
+            }
+        } catch (IOException uncertain) {
+            // A transport error can follow a successful write. Accept only an exact readback.
+            try {
+                verifyExisting(key, encoded);
+                return;
+            } catch (IOException readback) {
+                uncertain.addSuppressed(readback);
+                throw uncertain;
+            }
+        }
+        verifyExisting(key, encoded);
+    }
+
+    private void verifyExisting(String key, BytesReference expected) throws IOException {
+        final var existing = receipts.readRegister(key);
+        if (existing.isEmpty() || expected.equals(existing.get().value()) == false) {
+            throw new IOException("writer handoff receipt is missing or differs for this process");
+        }
+    }
+
+    /** Reads only the requested node incarnation. Absence supplies no handoff evidence. */
+    public Optional<WriterHandoffReport> read(String nodeId, String ephemeralId) throws IOException {
+        final var stored = receipts.readRegister(key(nodeId, ephemeralId));
+        if (stored.isEmpty()) {
+            return Optional.empty();
+        }
+        final BytesReference body = stored.get().value();
+        if (body.length() > MAX_BYTES) {
+            throw new IOException("writer handoff receipt exceeds the size limit");
+        }
+        try (var input = body.streamInput()) {
+            if (input.readVInt() != FORMAT
+                || nodeId.equals(input.readString()) == false
+                || ephemeralId.equals(input.readString()) == false) {
+                throw new IOException("writer handoff receipt format or process identity differs");
+            }
+            final int count = input.readVInt();
+            if (count < 0 || count > MAX_SHARDS) {
+                throw new IOException("writer handoff receipt exceeds the shard limit");
+            }
+            final var shards = new ArrayList<ShardResult>(count);
+            final var seen = new HashSet<ShardId>();
+            for (int i = 0; i < count; i++) {
+                final var shard = new ShardId(input);
+                final long term = input.readLong();
+                final var result = new ShardResult(
+                    shard,
+                    term,
+                    input.readBoolean(),
+                    Outcome.valueOf(input.readString()),
+                    input.readBoolean()
+                );
+                validateShard(result, seen);
+                shards.add(result);
+            }
+            if (input.read() != -1) {
+                throw new IOException("writer handoff receipt has trailing bytes");
+            }
+            return Optional.of(new WriterHandoffReport(nodeId, ephemeralId, shards));
+        } catch (IllegalArgumentException malformed) {
+            throw new IOException("malformed writer handoff receipt", malformed);
+        }
+    }
+
+    private static BytesReference encode(WriterHandoffReport report) throws IOException {
+        final var shards = new ArrayList<>(report.shards());
+        if (shards.size() > MAX_SHARDS) {
+            throw new IOException("writer handoff receipt exceeds the shard limit");
+        }
+        shards.sort(
+            Comparator.comparing((ShardResult shard) -> shard.shard().getIndexName())
+                .thenComparing(shard -> shard.shard().getIndex().getUUID())
+                .thenComparingInt(shard -> shard.shard().id())
+        );
+        final var seen = new HashSet<ShardId>();
+        try (var output = new BytesStreamOutput()) {
+            output.writeVInt(FORMAT);
+            output.writeString(report.nodeId());
+            output.writeString(report.ephemeralId());
+            output.writeVInt(shards.size());
+            for (ShardResult result : shards) {
+                validateShard(result, seen);
+                result.shard().writeTo(output);
+                output.writeLong(result.term());
+                output.writeBoolean(result.hibernated());
+                output.writeString(result.outcome().name());
+                output.writeBoolean(result.localCleanupComplete());
+                if (output.size() > MAX_BYTES) {
+                    throw new IOException("writer handoff receipt exceeds the size limit");
+                }
+            }
+            return output.bytes();
+        }
+    }
+
+    private static void validateShard(ShardResult result, HashSet<ShardId> seen) throws IOException {
+        final ShardId shard = result.shard();
+        if (shard.id() < 0 || shard.getIndexName().isEmpty() || shard.getIndex().getUUID().isEmpty() || seen.add(shard) == false) {
+            throw new IOException("writer handoff receipt includes an invalid or duplicate shard");
+        }
+        if (result.term() < -1 || (result.term() == -1 && result.outcome() != Outcome.UNCONFIRMED)) {
+            throw new IOException("writer handoff receipt includes an invalid term for the recorded outcome");
+        }
+    }
+
+    private static String key(String nodeId, String ephemeralId) {
+        if (nodeId == null
+            || PROCESS_ID.matcher(nodeId).matches() == false
+            || ephemeralId == null
+            || PROCESS_ID.matcher(ephemeralId).matches() == false) {
+            throw new IllegalArgumentException("writer handoff receipt requires exact node and ephemeral process IDs");
+        }
+        return nodeId + "." + ephemeralId;
+    }
+}
