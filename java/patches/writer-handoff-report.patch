+package org.opensearch.serverless.reconcile;
+
+import org.opensearch.common.annotation.InternalApi;
+import org.opensearch.core.index.shard.ShardId;
+import org.opensearch.serverless.metadata.ShardHeadStore;
+
+import java.util.List;
+
+/** Local shutdown results for the writers the node attempted to hand off. */
+@InternalApi
+public record WriterHandoffReport(String nodeId, String ephemeralId, List<ShardResult> shards) {
+    public WriterHandoffReport {
+        shards = List.copyOf(shards);
+    }
+
+    /** The result as witnessed by the outgoing process. */
+    public enum Outcome {
+        /** The applied unowned head names no node WAL. */
+        RELEASED,
+        /** The applied unowned head names WAL that the successor must check. */
+        RELEASED_WITH_WAL,
+        /** Only this member was relinquished. A sibling kept the shared bucket head. */
+        MEMBER_RELEASED,
+        /** The process did not confirm this release. The durable head may have changed. */
+        UNCONFIRMED
+    }
+
+    /** The observed writer identity and result. Term is -1 if no local writer could be inspected. */
+    public record ShardResult(ShardId shard, long term, boolean hibernated, Outcome outcome, boolean localCleanupComplete) {
+    }
+
+    public long releasedCount() {
+        return shards.stream().filter(shard -> shard.outcome() == Outcome.RELEASED || shard.outcome() == Outcome.RELEASED_WITH_WAL).count();
+    }
+
+    static Outcome outcomeOf(ShardHeadStore.Release release) {
+        if (release.appliedHead() != null) {
+            return release.appliedHead().writers().isEmpty() ? Outcome.RELEASED : Outcome.RELEASED_WITH_WAL;
+        }
+        return release.accepted() ? Outcome.MEMBER_RELEASED : Outcome.UNCONFIRMED;
+    }
+}
