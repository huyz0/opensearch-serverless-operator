+                    return actual;
+                }
+                return new DelegatingBlobContainer(actual) {
+                    @Override
+                    public BlobRegisterCasResult compareAndSwapRegister(String name, long generation, BytesReference value)
+                        throws IOException {
+                        final ShardHead head = ShardHead.fromStream(value.streamInput());
+                        if (head.term() > 1L && head.ownerNodeId() != null && head.writers().isEmpty()
+                            && failClear.compareAndSet(true, false)) {
+                            throw new IOException("injected WAL settlement failure");
+                        }
+                        return super.compareAndSwapRegister(name, generation, value);
+                    }
+                };
+            }
