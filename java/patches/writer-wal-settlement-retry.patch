+    private static BlobStore failOneWALSettlement(BlobStore delegate, AtomicBoolean failClear) {
+        return new BlobStore() {
+            @Override
+            public BlobContainer blobContainer(BlobPath path) {
+                final BlobContainer actual = delegate.blobContainer(path);
