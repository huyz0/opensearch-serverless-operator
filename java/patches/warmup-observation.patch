+    private AtomicBoolean runQueuedRetry(ServerlessNode node, MetadataPlane plane, long started, TimeValue maxWait) throws Exception {
+        final var callback = SearchWarmup.class.getDeclaredMethod(
+            "warmInBackground",
+            NodeContext.class,
+            MetadataPlane.class,
+            SearchReadiness.class,
+            AtomicBoolean.class,
+            long.class,
+            TimeValue.class,
+            boolean.class
+        );
+        callback.setAccessible(true);
+        final AtomicBoolean readyTransition = new AtomicBoolean();
+        callback.invoke(null, node, plane, SearchReadiness.of(node), readyTransition, started, maxWait, true);
+        return readyTransition;
+    }
