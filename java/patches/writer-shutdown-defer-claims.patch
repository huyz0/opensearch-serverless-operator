+    public void testPreparedRetirementLeavesAdvisoryAssignmentsForOpenAndHibernatedWriters() throws Exception {
+        final AtomicLong clock = new AtomicLong(1_000L);
+        final BlobPath base = BlobPath.cleanPath();
+        try (
+            HookedBlobStore store = new HookedBlobStore(new FsBlobStore(1024, createTempDir(), false));
+            ServerlessNode node = new ServerlessNode(nodeSettings("shutdown-cleanup"))
+        ) {
+            final MetadataPlane plane = new MetadataPlane(store, base, clock::get, TTL);
+            plane.createIndex(new IndexDescriptor("alpha", "uuid-alpha-00000000", 2, MAPPING, null));
+            node.startup().start();
+            node.setMetadataPlane(plane);
+            final BackgroundReconciler loop = loop(node, plane);
+            final ShardId sleeping = writeSome(node, plane, 0, 0, 2);
+            final long sleepingTerm = node.reconciler().shard(sleeping).getOperationPrimaryTerm();
+            clock.addAndGet(HIBERNATE_AFTER + 1);
+            loop.tick(clock.get());
+            assertTrue(node.hibernation().isHibernated("alpha", 0));
+            final ShardId open = writeSome(node, plane, 1, 2, 2);
+            final long openTerm = node.reconciler().shard(open).getOperationPrimaryTerm();
+            loop.close();
+            node.activation().closeWriterAdmission();
+            final String local = node.localNode().getId();
+            final String claims = RegisterMap.assignments(base, local).buildAsString();
+            store.onNextBlobDelete(claims, RegisterMap.assignmentBlob("alpha", 1), () -> {
+                fail("shutdown must not wait for an advisory assignment delete");
+            });
+            final var report = loop.handOverWriters(true);
+            assertEquals(
+                java.util.Set.of(
+                    new ShardResult(open, openTerm, false, Outcome.RELEASED, true),
+                    new ShardResult(sleeping, sleepingTerm, true, Outcome.RELEASED_WITH_WAL, true)
+                ),
+                java.util.Set.copyOf(report.shards())
+            );
+            assertNull(plane.heads().read("alpha", 0).orElseThrow().ownerNodeId());
+            assertNull(plane.heads().read("alpha", 1).orElseThrow().ownerNodeId());
+            assertEquals(
+                java.util.Set.of(java.util.Map.entry("alpha", 0), java.util.Map.entry("alpha", 1)),
+                java.util.Set.copyOf(plane.claimsOf(local))
+            );
+            assertTrue(plane.truthFor(local).assignments().isEmpty());
         }
     }
 
