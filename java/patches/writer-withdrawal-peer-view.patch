+    public void testLateRefreshCannotRestoreWriterEligibilityAfterWithdrawalWasObserved() throws Exception {
+        final AtomicLong now = new AtomicLong(1_000L);
+        try (var store = new HookedBlobStore(new FsBlobStore(1024, createTempDir(), false))) {
+            final var container = store.blobContainer(BlobPath.cleanPath());
+            final var observer = new BlobLeaseMembership(container, now::get, TTL);
+            final var writer = new BlobLeaseMembership(container, now::get, TTL);
+            final var last = new BlobLeaseMembership(container, now::get, TTL);
+            observer.renew(lease("a-observer", "ingest"));
+            writer.renew(lease("b-writer", "ingest"));
+            last.renew(lease("z-last", "search"));
+
+            // The older refresh has already read b-writer when it enters the read of z-last.
+            store.onNextRegisterRead("", BlobLeaseMembership.LEASE_PREFIX + "z-last", () -> {
+                try {
+                    writer.renew(lease("b-writer", "ingest", NodeLease.WRITER_TRAFFIC_WITHDRAWN));
+                    observer.refresh();
+                    assertTrue(
+                        observer.current().stream().anyMatch(lease -> lease.nodeId().equals("b-writer") && lease.writerTrafficWithdrawn())
+                    );
+                } catch (java.io.IOException e) {
+                    throw new AssertionError(e);
+                }
+            });
+            observer.refresh();
+            assertTrue(store.fired());
+            final NodeLease seen = observer.current().stream().filter(lease -> lease.nodeId().equals("b-writer")).findFirst().orElseThrow();
+            assertTrue(seen.writerTrafficWithdrawn());
+            assertFalse(seen.acceptsNewWriters());
+
+            now.addAndGet(TTL / 3 + 1);
+            writer.renew(new NodeLease("b-writer", "replacement", seen.address(), Set.of("ingest"), 0L));
+            observer.refresh();
+            final NodeLease replacement = observer.current()
+                .stream()
+                .filter(lease -> lease.nodeId().equals("b-writer"))
+                .findFirst()
+                .orElseThrow();
+            assertEquals("replacement", replacement.ephemeralId());
+            assertTrue(replacement.acceptsNewWriters());
+        }
     }
 
