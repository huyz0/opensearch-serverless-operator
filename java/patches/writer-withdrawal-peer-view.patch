+
+/** Reports a writer withdrawal from this process's current placement view. */
+public final class WriterWithdrawalViewHandler extends BaseRestHandler {
+    private static final String PATH =
+        "/_serverless/writer_withdrawal_view/{node_id}/{ephemeral_id}/{writer_node_id}/{writer_ephemeral_id}";
+    private final NodeContext node;
+    private final Supplier<Principal> principal;
+    private final String reader;
+
+    public WriterWithdrawalViewHandler(NodeContext node, Supplier<Principal> principal, String reader) {
+        this.node = node;
+        this.principal = principal;
+        this.reader = reader;
+    }
+
+    @Override
+    public String getName() {
+        return "serverless_writer_withdrawal_view";
+    }
+
+    @Override
+    public List<Route> routes() {
+        return List.of(new Route(RestRequest.Method.GET, PATH));
+    }
+
+    @Override
+    protected RestChannelConsumer prepareRequest(RestRequest request, NodeClient client) {
+        final String nodeId = request.param("node_id");
+        final String ephemeralId = request.param("ephemeral_id");
+        final String writerId = request.param("writer_node_id");
+        final String writerEpoch = request.param("writer_ephemeral_id");
+        final Principal caller = principal.get();
+        if (caller == null
+            || NamedPrincipal.UNAUTHENTICATED.getName().equals(caller.getName())
+            || reader.equals(caller.getName()) == false) {
+            return channel -> error(channel, RestStatus.FORBIDDEN, "not_permitted", "caller is not the configured writer handoff reader");
+        }
+        if (node.httpServerTransport instanceof SecureNetty4HttpServerTransport == false) {
+            return channel -> error(channel, RestStatus.FORBIDDEN, "writer_withdrawal_view_requires_tls", "withdrawal views require HTTPS");
+        }
+        if (WriterHandoffReceiptStore.isProcessId(nodeId) == false
+            || WriterHandoffReceiptStore.isProcessId(ephemeralId) == false
+            || WriterHandoffReceiptStore.isProcessId(writerId) == false
+            || WriterHandoffReceiptStore.isProcessId(writerEpoch) == false
+            || nodeId.equals(writerId)) {
+            return channel -> error(
+                channel,
+                RestStatus.BAD_REQUEST,
+                "invalid_process_identity",
+                "distinct observer and writer IDs are required"
+            );
+        }
+        final var metadata = node.metadataPlane();
+        if (node.isStarted() == false || metadata == null) {
+            return channel -> error(
+                channel,
+                RestStatus.SERVICE_UNAVAILABLE,
+                "writer_withdrawal_view_unavailable",
+                "placement view unavailable"
+            );
+        }
+        final var local = node.localNode();
+        if (nodeId.equals(local.getId()) == false || ephemeralId.equals(local.getEphemeralId()) == false) {
+            return channel -> error(channel, RestStatus.CONFLICT, "observer_process_changed", "target does not identify this Java process");
+        }
+        return channel -> {
+            final long now = metadata.clock().getAsLong();
+            // Use the same cached view as cold placement. Reading the store here would confirm publication only.
+            final long remaining = metadata.membership()
+                .current()
+                .stream()
+                .filter(
+                    lease -> writerId.equals(lease.nodeId())
+                        && writerEpoch.equals(lease.ephemeralId())
+                        && lease.isExpiredAt(now) == false
+                        && lease.roles().contains(NodeContext.ROLE_INGEST)
+                        && lease.writerTrafficWithdrawn()
+                )
+                .mapToLong(lease -> lease.expiresAtMillis() - now)
+                .findFirst()
+                .orElse(0L);
+            try (var content = channel.newBuilder()) {
+                content.startObject();
+                content.field("version", 1);
+                content.startObject("observer");
+                content.field("node_id", local.getId());
+                content.field("ephemeral_id", local.getEphemeralId());
+                content.endObject();
+                content.startObject("writer");
+                content.field("node_id", writerId);
+                content.field("ephemeral_id", writerEpoch);
+                content.endObject();
+                content.field("withdrawn", remaining > 0L);
+                content.field("lease_remaining_millis", remaining);
+                content.endObject();
+                send(channel, new BytesRestResponse(RestStatus.OK, content));
+            }
+        };
+    }
+
+    private static void error(RestChannel channel, RestStatus status, String type, String reason) throws IOException {
+        send(channel, RestReplies.error(channel, status, type, reason));
+    }
+
+    private static void send(RestChannel channel, BytesRestResponse response) {
+        response.addHeader("Cache-Control", "no-store");
+        channel.sendResponse(response);
+    }
+}
