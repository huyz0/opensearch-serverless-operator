+    public void testWriterWithdrawalExpiresWhileWaitingForTheReservationLock() throws Exception {
+        try (var node = new ServerlessNode(settings("withdrawal-expiry"))) {
+            final var activation = node.activation();
+            final long deadline = System.currentTimeMillis() + 5_000;
+            final var withdrawal = new FutureTask<>(() -> activation.withdrawForRetirement("operation", deadline));
+            final var worker = new Thread(withdrawal, "queued-withdrawal");
+            try {
+                synchronized (activation) {
+                    worker.start();
+                    assertBusy(() -> assertEquals(Thread.State.BLOCKED, worker.getState()));
+                    assertTrue("withdrawal must reach the lock before expiry", System.currentTimeMillis() < deadline);
+                    assertBusy(() -> assertTrue(System.currentTimeMillis() >= deadline));
+                }
+                assertEquals(RetirementState.OPEN, withdrawal.get(30, TimeUnit.SECONDS));
+                assertFalse(activation.isWriterTrafficWithdrawn());
+                assertEquals(RetirementState.WITHDRAWN, activation.withdrawForRetirement("operation", Long.MAX_VALUE));
+            } finally {
+                worker.join(TimeUnit.SECONDS.toMillis(30));
+                assertFalse("withdrawal worker did not exit", worker.isAlive());
+            }
+        }
+    }
