+import java.util.List;
+import java.util.Locale;
+import java.util.function.Supplier;
+
+/** Reserves and drains writer admission for one operation on this JVM. */
+public final class WriterRetirementHandler extends BaseRestHandler {
+    private static final String PATH = "/_serverless/writer_retirement/{node_id}/{ephemeral_id}/{operation_id}";
+    private final NodeContext node;
+    private final Supplier<Principal> principal;
+    private final String preparer;
+
+    public WriterRetirementHandler(NodeContext node, Supplier<Principal> principal, String preparer) {
+        this.node = node;
+        this.principal = principal;
+        this.preparer = preparer;
+    }
+
+    @Override
+    public String getName() {
+        return "serverless_writer_retirement";
+    }
+
+    @Override
+    public List<Route> routes() {
+        return List.of(new Route(RestRequest.Method.GET, PATH), new Route(RestRequest.Method.POST, PATH));
+    }
+
+    @Override
+    protected RestChannelConsumer prepareRequest(RestRequest request, NodeClient client) {
+        final String nodeId = request.param("node_id");
+        final String ephemeralId = request.param("ephemeral_id");
+        final String operation = request.param("operation_id");
+        final Principal caller = principal.get();
+        if (caller == null
+            || NamedPrincipal.UNAUTHENTICATED.getName().equals(caller.getName())
+            || preparer.equals(caller.getName()) == false) {
+            return channel -> error(channel, RestStatus.FORBIDDEN, "not_permitted", "caller is not the configured retirement preparer");
+        }
+        if (node.httpServerTransport instanceof SecureNetty4HttpServerTransport == false) {
+            return channel -> error(channel, RestStatus.FORBIDDEN, "writer_retirement_requires_tls", "writer retirement requires HTTPS");
+        }
+        if (WriterHandoffReceiptStore.isProcessId(nodeId) == false
+            || WriterHandoffReceiptStore.isProcessId(ephemeralId) == false
+            || WriterHandoffReceiptStore.isProcessId(operation) == false) {
+            return channel -> error(
+                channel,
+                RestStatus.BAD_REQUEST,
+                "invalid_retirement_identity",
+                "valid process and operation IDs are required"
+            );
+        }
+        if (node.isStarted() == false || node.metadataPlane() == null) {
+            return channel -> unavailable(channel);
+        }
+        final var local = node.localNode();
+        if (nodeId.equals(local.getId()) == false || ephemeralId.equals(local.getEphemeralId()) == false) {
+            return channel -> error(channel, RestStatus.CONFLICT, "writer_process_changed", "target does not identify this Java process");
+        }
+        if (request.method() == RestRequest.Method.GET) {
+            return channel -> respond(channel, nodeId, ephemeralId, operation, node.activation().retirementState(operation));
+        }
+        return channel -> node.threadPool().generic().execute(new AbstractRunnable() {
+            @Override
+            protected void doRun() throws IOException {
+                respond(channel, nodeId, ephemeralId, operation, node.activation().prepareRetirement(operation));
+            }
+
+            @Override
+            public void onFailure(Exception failure) {
+                try {
+                    unavailable(channel);
+                } catch (IOException responseFailure) {
+                    RestReplies.logResponseFailure(logger, getName(), responseFailure);
+                }
+            }
+        });
+    }
+
+    private static void respond(RestChannel channel, String nodeId, String ephemeralId, String operation, RetirementState state)
+        throws IOException {
+        if (state == RetirementState.CONFLICT) {
+            error(
+                channel,
+                RestStatus.CONFLICT,
+                "writer_admission_already_reserved",
+                "writer admission belongs to another retirement or shutdown"
+            );
+            return;
+        }
+        try (var content = channel.newBuilder()) {
+            content.startObject();
+            content.field("version", 1);
+            content.field("node_id", nodeId);
+            content.field("ephemeral_id", ephemeralId);
+            content.field("operation_id", operation);
+            content.field("state", state.name().toLowerCase(Locale.ROOT));
+            content.endObject();
+            send(channel, new BytesRestResponse(RestStatus.OK, content));
+        }
+    }
+
+    private static void unavailable(RestChannel channel) throws IOException {
+        error(channel, RestStatus.SERVICE_UNAVAILABLE, "writer_retirement_unavailable", "writer retirement state is unavailable");
+    }
+
+    private static void error(RestChannel channel, RestStatus status, String type, String reason) throws IOException {
+        send(channel, RestReplies.error(channel, status, type, reason));
+    }
+
+    private static void send(RestChannel channel, BytesRestResponse response) {
+        response.addHeader("Cache-Control", "no-store");
+        channel.sendResponse(response);
+    }
+}
