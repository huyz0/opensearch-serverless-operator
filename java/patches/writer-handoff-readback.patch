+    public void testWriterHandoffReceiptRequiresTheConfiguredIdentity() throws Exception {
+        final AtomicLong clock = new AtomicLong(1_000L);
+        final MetadataPlane plane = plane(clock);
+        final Settings settings = Settings.builder()
+            .put(nodeSettings("auth-receipt"))
+            .put(NodeSettings.WRITER_HANDOFF_READER.getKey(), "receipt-reader")
+            .build();
+        final String path = "/_serverless/writer_handoffs/writer/old-process";
+        final String account = basic("receipt-reader", "reader-password");
+        try (ServerlessNode node = new ServerlessNode(settings, List.of(authPlugin(settings)))) {
+            node.startup().start();
+            node.setMetadataPlane(plane);
+            ready(node, plane, clock);
+            final var result = new WriterHandoffReport.ShardResult(
+                new ShardId("alpha", "uuid-alpha", 0),
+                7L,
+                false,
+                WriterHandoffReport.Outcome.RELEASED_WITH_WAL,
+                true
+            );
+            new WriterHandoffReceiptStore(plane.blobStore(), BlobPath.cleanPath()).persist(
+                new WriterHandoffReport("writer", "old-process", List.of(result))
+            );
+
+            assertEquals(401, send(node, "GET", path, null, null).status());
+            assertEquals(403, send(node, "GET", path, basic(ADMIN, ADMIN_PASSWORD), null).status());
+            final Response created = send(
+                node,
+                "PUT",
+                "/_serverless/security/users/receipt-reader",
+                basic(ADMIN, ADMIN_PASSWORD),
+                "{\"password\":\"reader-password\"}"
+            );
+            assertEquals(created.body(), 200, created.status());
+            assertEquals(401, send(node, "GET", path, basic("receipt-reader", "wrong-password"), null).status());
+            final Response allowed = send(node, "GET", path, account, null);
+            assertEquals(allowed.body(), 200, allowed.status());
+            assertEquals("no-store", allowed.header("Cache-Control"));
+            assertTrue(allowed.body(), allowed.body().contains("\"ephemeral_id\":\"old-process\""));
+            assertTrue(allowed.body(), allowed.body().contains("\"term\":7"));
+            assertTrue(allowed.body(), allowed.body().contains("\"outcome\":\"RELEASED_WITH_WAL\""));
+            final Response missing = send(node, "GET", "/_serverless/writer_handoffs/writer/new-process", account, null);
+            assertEquals(404, missing.status());
+            assertTrue(missing.body(), missing.body().contains("writer_handoff_receipt_missing"));
+            final var receipts = ConditionalBlobContainer.of(plane.blobStore().blobContainer(BlobPath.cleanPath().add("writer-handoffs")));
+            assertTrue(receipts.createRegisterIfAbsent("writer.corrupt", new BytesArray(new byte[] { 99 })).applied());
+            final Response unreadable = send(node, "GET", "/_serverless/writer_handoffs/writer/corrupt", account, null);
+            assertEquals(503, unreadable.status());
+            assertTrue(unreadable.body(), unreadable.body().contains("writer_handoff_receipt_unavailable"));
+            assertEquals(400, send(node, "GET", "/_serverless/writer_handoffs/writer/bad.id", account, null).status());
+        }
+    }
