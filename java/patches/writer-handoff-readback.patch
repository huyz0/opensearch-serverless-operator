+/** Serves an exact process's durable writer receipt to the configured identity. */
+public final class WriterHandoffReceiptHandler extends BaseRestHandler {
+    private final Supplier<MetadataPlane> plane;
+    private final ThreadPool threadPool;
+    private final Supplier<Principal> principal;
+    private final String reader;
+
+    public WriterHandoffReceiptHandler(Supplier<MetadataPlane> plane, ThreadPool threadPool, Supplier<Principal> principal, String reader) {
+        this.plane = plane;
+        this.threadPool = threadPool;
+        this.principal = principal;
+        this.reader = reader;
+    }
+
+    @Override
+    public String getName() {
+        return "serverless_writer_handoff_receipt";
+    }
+
+    @Override
+    public List<Route> routes() {
+        return List.of(new Route(RestRequest.Method.GET, "/_serverless/writer_handoffs/{node_id}/{ephemeral_id}"));
+    }
+
+    @Override
+    protected RestChannelConsumer prepareRequest(RestRequest request, NodeClient client) {
+        final String nodeId = request.param("node_id");
+        final String ephemeralId = request.param("ephemeral_id");
+        final Principal caller = principal.get();
+        if (caller == null
+            || NamedPrincipal.UNAUTHENTICATED.getName().equals(caller.getName())
+            || reader.equals(caller.getName()) == false) {
+            return channel -> error(channel, RestStatus.FORBIDDEN, "not_permitted", "caller is not the configured writer handoff reader");
+        }
+        final MetadataPlane metadata = plane.get();
+        if (metadata == null) {
+            return channel -> unavailable(channel);
+        }
+        return channel -> threadPool.generic().execute(new AbstractRunnable() {
+            @Override
+            protected void doRun() throws IOException {
+                read(channel, metadata, nodeId, ephemeralId);
+            }
+
+            @Override
+            public void onFailure(Exception failure) {
+                try {
+                    unavailable(channel);
+                } catch (IOException responseFailure) {
+                    RestReplies.logResponseFailure(logger, getName(), responseFailure);
+                }
+            }
+        });
+    }
+
+    private static void read(RestChannel channel, MetadataPlane metadata, String nodeId, String ephemeralId) throws IOException {
+        final var receipts = new WriterHandoffReceiptStore(metadata.blobStore(), BlobPath.cleanPath());
+        final Optional<WriterHandoffReport> receipt;
+        try {
+            receipt = receipts.read(nodeId, ephemeralId);
+        } catch (IllegalArgumentException invalidIdentity) {
+            error(channel, RestStatus.BAD_REQUEST, "invalid_process_identity", "valid node and ephemeral IDs are required");
+            return;
+        }
+        if (receipt.isEmpty()) {
+            error(channel, RestStatus.NOT_FOUND, "writer_handoff_receipt_missing", "no receipt exists for this process");
+            return;
+        }
+        final var report = receipt.get();
+        try (var content = channel.newBuilder()) {
+            content.startObject();
+            content.field("version", 1);
+            content.field("node_id", report.nodeId());
+            content.field("ephemeral_id", report.ephemeralId());
+            content.startArray("shards");
+            for (var result : report.shards()) {
+                content.startObject();
+                content.field("index", result.shard().getIndexName());
+                content.field("index_uuid", result.shard().getIndex().getUUID());
+                content.field("shard", result.shard().id());
+                content.field("term", result.term());
+                content.field("hibernated", result.hibernated());
+                content.field("outcome", result.outcome().name());
+                content.field("local_cleanup_complete", result.localCleanupComplete());
+                content.endObject();
+            }
+            content.endArray();
+            content.endObject();
+            send(channel, new BytesRestResponse(RestStatus.OK, content));
+        }
+    }
+
+    private static void unavailable(RestChannel channel) throws IOException {
+        error(channel, RestStatus.SERVICE_UNAVAILABLE, "writer_handoff_receipt_unavailable", "writer handoff receipt could not be read");
+    }
+
+    private static void error(RestChannel channel, RestStatus status, String type, String reason) throws IOException {
+        send(channel, RestReplies.error(channel, status, type, reason));
+    }
+
+    private static void send(RestChannel channel, BytesRestResponse response) {
+        response.addHeader("Cache-Control", "no-store");
+        channel.sendResponse(response);
+    }
+}
