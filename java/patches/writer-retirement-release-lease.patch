+    public void testPreparedRetirementExpiresAndUnenrollsWithoutProbingForPhysicalDelete() throws Exception {
+        final AtomicLong now = new AtomicLong(1_000L);
+        final var store = container(createTempDir());
+        final var writer = new BlobLeaseMembership(store, now::get, TTL).conditionalDeletes(() -> {
+            throw new AssertionError("prepared retirement must not probe conditional deletes");
+        });
+        final var peer = new BlobLeaseMembership(store, now::get, TTL);
+        writer.renew(lease("retiring", "ingest"));
+        peer.renew(lease("surviving", "ingest"));
+        assertEquals(Set.of("retiring", "surviving"), peer.enrolledIds());
+
+        writer.releaseForRetirement("retiring");
+
+        final NodeLease expired = peer.read("retiring").orElseThrow();
+        assertTrue(expired.isExpiredAt(now.get()));
+        assertEquals("retiring-eph", expired.ephemeralId());
+        assertEquals(Set.of("surviving"), peer.enrolledIds());
+        assertEquals(List.of("surviving"), peer.refresh().stream().map(NodeLease::nodeId).toList());
+    }
